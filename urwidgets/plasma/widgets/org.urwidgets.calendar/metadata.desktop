[Desktop Entry]
Name=URWidgets — Monthly Calendar
Comment=Clean monthly calendar with Indonesian and English localization
Icon=view-calendar
Type=Service
X-KDE-ServiceTypes=Plasma/Applet

X-Plasma-API=declarativeappletscript
X-Plasma-MainScript=ui/main.qml

X-KDE-PluginInfo-Author=Haris Gitama
X-KDE-PluginInfo-Email=https://github.com/Harisgitama
X-KDE-PluginInfo-Name=org.urwidgets.calendar
X-KDE-PluginInfo-Version=3.1.0
X-KDE-PluginInfo-Website=https://rissaxie.com
X-KDE-PluginInfo-Category=System Information
X-KDE-PluginInfo-License=MIT
X-KDE-PluginInfo-EnabledByDefault=true
